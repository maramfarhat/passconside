# PASS AI backend → RunPod SGLang (OpenAI-compatible)
# Copy to .env and fill in (never commit .env)

# Upstream inference (SGLang on RunPod). Examples:
#   SSH tunnel:  http://127.0.0.1:30000/v1
#   RunPod HTTP: https://YOUR_POD_ID-30000.proxy.runpod.net/v1
PASS_AI_INFERENCE_BASE_URL=http://127.0.0.1:30000/v1
PASS_AI_INFERENCE_ADMIN_URL=http://127.0.0.1:30001

# Same Bearer key as configured on the pod (/workspace/pass-ai/config/api-key.env)
PASS_AI_INFERENCE_API_KEY=

# Optional: require this key on local /v1/* (PASS AI OpenAI Compatible provider)
PASS_AI_API_KEY=

PASS_AI_DEFAULT_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
SERVER_PORT=8080
